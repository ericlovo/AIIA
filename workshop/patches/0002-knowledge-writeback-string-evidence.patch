+def _as_list(value: Any) -> list[str]:
+    """Coerce a candidate field that should be a list of strings. A bare
+    string becomes a one-entry list rather than being iterated per character;
+    `None` becomes empty. Non-string entries are rendered, not dropped, so a
+    malformed candidate stays visible in the artifact instead of vanishing."""
+    if value is None:
+        return []
+    if isinstance(value, str):
+        return [value] if value.strip() else []
+    if isinstance(value, (list, tuple)):
+        return [str(v) for v in value if str(v).strip()]
+    return [str(value)]
